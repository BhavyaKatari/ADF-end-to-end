{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfprojectetoe"
		},
		"LS_azuresqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_azuresqlserver'"
		},
		"LS_Azurekeyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://adfprjctkeyvault.vault.azure.net/"
		},
		"LS_azuresqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "testserveradf.database.windows.net"
		},
		"LS_azuresqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testdb"
		},
		"LS_azuresqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Bhavya"
		},
		"LS_gen2stagelayer_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://staginglayrgen2.dfs.core.windows.net"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfprojectetoe_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_azuresqlserver_password": {
						"value": "[parameters('LS_azuresqlserver_password')]"
					},
					"LS_Azurekeyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Azurekeyvault_properties_typeProperties_baseUrl')]"
					},
					"LS_azuresqlserver_properties_typeProperties_server": {
						"value": "[parameters('LS_azuresqlserver_properties_typeProperties_server')]"
					},
					"LS_azuresqlserver_properties_typeProperties_database": {
						"value": "[parameters('LS_azuresqlserver_properties_typeProperties_database')]"
					},
					"LS_azuresqlserver_properties_typeProperties_userName": {
						"value": "[parameters('LS_azuresqlserver_properties_typeProperties_userName')]"
					},
					"LS_gen2stagelayer_properties_typeProperties_url": {
						"value": "[parameters('LS_gen2stagelayer_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfprojectetoe_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfprojectetoe_ArmTemplate_0')]"
			]
		}
	]
}